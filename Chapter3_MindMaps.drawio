<mxfile host="app.diagrams.net" type="device" version="24.0.0">
  <diagram name="1. Master Map" id="master">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="m_root" value="Chapter 3&#10;BASIC I/O" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f3864;fontColor=#ffffff;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="40" width="160" height="60" as="geometry" /></mxCell>

        <mxCell id="m_why" value="WHY I/O&#10;Speed mismatch:&#10;kbd few/s · display thousands/s · CPU billions/s&#10;→ need synchronization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="m_acc" value="ACCESSING DEVICES (3.1)&#10;• Memory-mapped I/O (Load/Store)&#10;• Port-mapped I/O (In/Out)&#10;• Interface: DATA · STATUS · CONTROL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="160" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="m_poll" value="PROGRAM-CONTROLLED I/O (3.1)&#10;Polling: spin on status flag (wastes CPU)&#10;• RISC program (Fig 3.4)&#10;• CISC program (Fig 3.5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="620" y="160" width="260" height="80" as="geometry" /></mxCell>
        <mxCell id="m_int" value="INTERRUPTS (3.2)&#10;Device alerts CPU → ISR handles it&#10;• Enable/disable (IE)  • Multiple devices&#10;• Vectored + IVT  • Control regs  • Fig 3.8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="920" y="160" width="260" height="80" as="geometry" /></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="m_root" target="m_why"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="m_root" target="m_acc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="m_root" target="m_poll"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="m_root" target="m_int"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="2. Memory-Mapped I/O" id="mmio">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="mm_root" value="MEMORY-MAPPED I/O" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f3864;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="480" y="40" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="mm_idea" value="CORE IDEA&#10;Devices get REAL addresses,&#10;stolen from RAM's address space" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="mm_cons" value="CONSEQUENCE&#10;Any memory instruction works:&#10;Load R2, DATAIN&#10;Store R2, DATAOUT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="320" y="160" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="mm_impl" value="IMPLEMENTED AS&#10;Flip-flops (1 bit each)&#10;8 = byte register · 32 = word register&#10;→ called I/O registers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="580" y="160" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="mm_alt" value="ALTERNATIVE&#10;Port-mapped I/O&#10;Special In/Out, separate space (x86)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="860" y="160" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="mm_an" value="ANALOGY (postman)&#10;RAM = mailboxes 1–900&#10;Devices = mailboxes 901–910&#10;Same delivery routine for all" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="440" y="300" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="me1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="mm_root" target="mm_idea"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="mm_root" target="mm_cons"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="mm_root" target="mm_impl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="mm_root" target="mm_alt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="mm_root" target="mm_an"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="3. Register Map" id="regmap">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rk_title" value="KEYBOARD INTERFACE (base 0x4000)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="440" height="30" as="geometry" /></mxCell>
        <mxCell id="rk_data" value="0x4000  KBD_DATA  — 8-bit ASCII of pressed key" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="440" height="40" as="geometry" /></mxCell>
        <mxCell id="rk_stat" value="0x4004  KBD_STATUS — KIN (bit1, key waiting) · KIRQ (bit0, irq raised)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="440" height="40" as="geometry" /></mxCell>
        <mxCell id="rk_cont" value="0x4008  KBD_CONT  — KIE (bit1, allow interrupts) [software]" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="440" height="40" as="geometry" /></mxCell>

        <mxCell id="rd_title" value="DISPLAY INTERFACE (base 0x4010)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="440" height="30" as="geometry" /></mxCell>
        <mxCell id="rd_data" value="0x4010  DISP_DATA  — 8-bit char to display" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="90" width="440" height="40" as="geometry" /></mxCell>
        <mxCell id="rd_stat" value="0x4014  DISP_STATUS — DOUT (bit2, ready) · DIRQ (bit1, irq raised)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="130" width="440" height="40" as="geometry" /></mxCell>
        <mxCell id="rd_cont" value="0x4018  DISP_CONT  — DIE (bit2, allow interrupts) [software]" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="170" width="440" height="40" as="geometry" /></mxCell>

        <mxCell id="rn" value="Three register types everywhere:  DATA = the byte  ·  STATUS = ready?  ·  CONTROL = configure&#10;Addresses are +4 apart → word-aligned (32-bit word = 4 bytes).&#10;Use LoadByte / StoreByte (1 byte), NOT Load (would grab 4 adjacent registers)." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="1000" height="90" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="4. Polling vs Interrupts" id="decision">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d_start" value="Need I/O transfer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f3864;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="40" width="180" height="50" as="geometry" /></mxCell>
        <mxCell id="d_q1" value="Can device raise&#10;interrupts? (HW support)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="470" y="140" width="200" height="100" as="geometry" /></mxCell>
        <mxCell id="d_poll" value="POLLING&#10;• CPU spins on status flag&#10;• Simple to code&#10;• WASTES CPU cycles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="140" y="320" width="240" height="100" as="geometry" /></mxCell>
        <mxCell id="d_q2" value="Event rare/slow?&#10;(keyboard, multitasking OS)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="470" y="310" width="200" height="120" as="geometry" /></mxCell>
        <mxCell id="d_int" value="INTERRUPTS&#10;• Device signals CPU when ready&#10;• CPU free for other work&#10;• Needs ISR + enable bits + save/restore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="780" y="320" width="280" height="100" as="geometry" /></mxCell>
        <mxCell id="d_note" value="The choice is a SOFTWARE decision (if the hardware supports interrupts at all)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="400" y="480" width="360" height="40" as="geometry" /></mxCell>

        <mxCell id="de1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d_start" target="d_q1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de2" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;fontStyle=1;" edge="1" parent="1" source="d_q1" target="d_poll"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;fontStyle=1;" edge="1" parent="1" source="d_q1" target="d_q2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de4" value="No (fast tight loop)" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d_q2" target="d_poll"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;fontStyle=1;" edge="1" parent="1" source="d_q2" target="d_int"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="5. Interrupt Lifecycle" id="lifecycle">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="l0" value="INIT (Main): KIE=1 · IENABLE[KBD]=1 · PS.IE=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="360" y="30" width="340" height="40" as="geometry" /></mxCell>
        <mxCell id="l1" value="1. User presses key 'A'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="l2" value="2. Keyboard HW: ASCII → KBD_DATA, set KIN=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="135" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="l3" value="3. HW: (KIE AND KIN) → KIRQ=1, assert IRQ line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="380" y="180" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="l4" value="4. CPU: finish current instruction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="380" y="225" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="l5" value="5. CPU: save PC; PS→IPS; clear IE (block further IRQ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="380" y="270" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="l6" value="6. CPU: jump to ISR at ILOC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="380" y="315" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="l7" value="7. ISR: push R2, R3 on stack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="360" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="l8" value="8. ISR: LoadByte KBD_DATA → HW clears KIN &amp; KIRQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="405" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="l9" value="9. ISR: store char, bump pointer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="450" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="l10" value="10. ISR: poll DOUT, echo char to display" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="495" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="l11" value="11. ISR: if char==CR → set EOL=1, write KIE=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="540" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="l12" value="12. ISR: pop R2, R3  →  13. Return-from-interrupt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="585" width="300" height="30" as="geometry" /></mxCell>
        <mxCell id="l14" value="14. CPU: restore PC &amp; PS (IE=1 again) → resume Main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="380" y="630" width="300" height="30" as="geometry" /></mxCell>

        <mxCell id="le1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="l4" target="l5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="l5" target="l6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="l6" target="l7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le7" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="l7" target="l8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le8" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="l8" target="l9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le9" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="l9" target="l10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le10" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="l10" target="l11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le11" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="l11" target="l12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le12" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="l12" target="l14"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="6. Control Regs + 2-Gate" id="ctrlregs">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_title" value="PROCESSOR CONTROL REGISTERS (Fig 3.7) — all 32-bit, reached ONLY by MoveControl" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f3864;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="30" width="700" height="40" as="geometry" /></mxCell>
        <mxCell id="c_ps" value="PS (Processor Status)&#10;IE (bit0) = GLOBAL interrupt switch&#10;+ condition flags N, Z, C, V" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="100" width="320" height="70" as="geometry" /></mxCell>
        <mxCell id="c_ips" value="IPS (Saved PS)&#10;HW backup of PS on entry;&#10;restored on return. ONLY ONE&#10;→ nesting must save it on the stack." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="320" height="70" as="geometry" /></mxCell>
        <mxCell id="c_ien" value="IENABLE&#10;Per-device enable mask&#10;bit1=KBD · bit2=DISP · bit3=TIM&#10;1 = accept that device" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="320" height="70" as="geometry" /></mxCell>
        <mxCell id="c_ipend" value="IPENDING&#10;Per-device 'requesting now' flags&#10;HW sets the requesting device's bit&#10;SW reads it to pick priority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="460" y="200" width="320" height="70" as="geometry" /></mxCell>
        <mxCell id="c_gate" value="TWO-GATE RULE — BOTH must be 1 for an interrupt to fire:&#10;&#10;        [ PS.IE = 1 ]   AND   [ IENABLE[device] = 1 ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="320" width="700" height="80" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="7. Keyboard Flag Logic" id="flaglogic">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="f_sw" value="SOFTWARE sets&#10;KIE = 1&#10;(arming switch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="f_key" value="Key pressed →&#10;HW sets KIN = 1&#10;(data waiting)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="f_and" value="KIE AND KIN" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="360" y="130" width="160" height="100" as="geometry" /></mxCell>
        <mxCell id="f_irq" value="HW sets KIRQ = 1&#10;assert interrupt line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="620" y="145" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="f_read" value="ISR reads KBD_DATA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="300" width="200" height="40" as="geometry" /></mxCell>
        <mxCell id="f_clr" value="HW clears KIN=0&#10;→ (KIE AND KIN) false&#10;→ HW clears KIRQ=0 (drop request)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="580" y="370" width="280" height="70" as="geometry" /></mxCell>
        <mxCell id="f_who" value="WHO CONTROLS WHAT:  KIE = software · KIN = hardware · KIRQ = hardware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="480" width="740" height="40" as="geometry" /></mxCell>

        <mxCell id="fe1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="f_sw" target="f_and"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="f_key" target="f_and"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe3" value="both 1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontStyle=1;" edge="1" parent="1" source="f_and" target="f_irq"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="f_irq" target="f_read"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="f_read" target="f_clr"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="8. RISC vs CISC" id="riscisc">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rc_risc_t" value="RISC (Load/Store)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="60" width="440" height="30" as="geometry" /></mxCell>
        <mxCell id="rc_risc" value="• Cannot test/add directly in memory&#10;• Must Load → operate → Store&#10;• Poll kbd = 3 instr (LoadByte, And, Branch)&#10;• Separate Add to bump the pointer&#10;• Many simple instructions" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="90" width="440" height="150" as="geometry" /></mxCell>
        <mxCell id="rc_cisc_t" value="CISC (operate on memory)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="440" height="30" as="geometry" /></mxCell>
        <mxCell id="rc_cisc" value="• TestBit dst,#k — tests bit in memory, sets Z (Z=1 if bit=0)&#10;• MoveByte memory → memory&#10;• Autoincrement (R2)+&#10;• Poll kbd = 2 instr (TestBit, Branch=0)&#10;• Few powerful instructions" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="90" width="440" height="150" as="geometry" /></mxCell>
        <mxCell id="rc_trade" value="TRADE-OFF: RISC = simpler HW, fast per instruction.  CISC = shorter code, but each instruction = more micro-ops." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="80" y="280" width="980" height="50" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="9. Context Saving" id="context">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="x_root" value="CONTEXT SAVING&#10;(speed vs complexity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f3864;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="40" width="220" height="50" as="geometry" /></mxCell>
        <mxCell id="x_min" value="MINIMAL (used in Fig 3.8)&#10;HW saves PC + PS only&#10;ISR pushes only regs it uses&#10;→ Lowest overhead/latency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="x_uni" value="UNIVERSAL&#10;HW auto-saves R0..R31&#10;Easy to program&#10;→ HIGH latency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="420" y="170" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="x_sh" value="SHADOW REGISTERS&#10;Duplicate register bank&#10;Instant bank switch&#10;→ Near-zero overhead, costs silicon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="760" y="170" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="x_who" value="WHO DECIDES: HW architect builds the mechanism; SW driver/compiler chooses how to use it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="280" y="320" width="580" height="40" as="geometry" /></mxCell>
        <mxCell id="xe1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="x_root" target="x_min"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="xe2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="x_root" target="x_uni"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="xe3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="x_root" target="x_sh"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
